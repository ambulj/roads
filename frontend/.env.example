# RoadSaarthi Frontend — Environment Variables
# Copy this file to .env.local and fill in your values

# WebSocket server URL
# Leave empty to use smart auto-detection (dev => ws://127.0.0.1:8000, prod => same host)
# Example for custom backend: VITE_WS_URL=ws://192.168.1.100:8000/ws/telemetry
VITE_WS_URL=

# API base URL (optional - defaults to /api via Vite proxy)
# VITE_API_BASE=http://localhost:8000
