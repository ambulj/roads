# ============================================================
# RoadSaarthi Backend — Environment Template
# Copy this file to .env and fill in your values.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Leave as "sqlite" for local/demo use (no setup needed).
# Or set a full PostgreSQL URL for production.
DATABASE_URL=sqlite
# DATABASE_URL=postgresql://roadsaarthi:yourpassword@localhost:5432/roadsaarthi_db

USE_POSTGIS=false

# ── Backend Server ───────────────────────────────────────────
PORT=8000
HOST=127.0.0.1

# ── Synthetic Data Generation ────────────────────────────────
SYNTHETIC_INTERVAL_SECONDS=300
